1.	Resumo executivo

Verificar os pontos extremos de operação do SIN.
2. Contexto e problema

Os maiores problema de atendimento do setor eletrico são: 

- valores maximos de carga, onde se faz necessario o despacho otimizado das gerações presentes no SIN.

- valores minimos de carga, onde se faz necessario operar o sistema reduzindo parte gerações despachada, abrindo linhas de transmissão do SIN e outras medidas operativa.
3. Compreensão do conjunto de dados

O conjunto de dados fornecido continha informações de:

Código do Subsistema da Usina

Nome do Subsistema

Data de Referência

Valor verificado de geração hidráulica, em MWmed

Valor verificado de geração térmica, em MWmed

Valor verificado de geração eólica, em MWmed

Valor verificado de geração fotovoltaica, em MWmed

Valor verificado da carga, em MWmed

Valor verificado do intercâmbio líquido, em MWmed
# local dos dados brutos da Base_Dados_Projeto_Integrador_Dados_Brutos

import pandas as pd
from pathlib import Path
import json
import matplotlib.pyplot as plt
import seaborn as sns

# OS ARQUIVOS ESTÃO NO MESMO DIRETÓRIO DO SCRIPT, PORTANTO, NÃO É NECESSÁRIO INFORMAR O CAMINHO COMPLETO

pasta = Path(".")  # Diretório atual

# Arquivos que serão importados
arquivos = [
    "BALANCO_ENERGIA_SUBSISTEMA_2023.csv",
    "BALANCO_ENERGIA_SUBSISTEMA_2024.csv",
    "BALANCO_ENERGIA_SUBSISTEMA_2025.csv"
]

lista_df = []

for arquivo in arquivos:

    caminho = pasta / arquivo

#    print(f"Importando: {arquivo}")

    df = pd.read_csv(caminho, sep=";")

    # Identifica o arquivo de origem
    #df["arquivo_origem"] = arquivo

    lista_df.append(df)

# Junta os três arquivos em um único DataFrame
df_final = pd.concat(lista_df, ignore_index=True)

#print("\nImportação concluída!")
#print(df_final.shape)

# verifica se os dados foram importados corretamente
# print(df_final.head())

#print(df_final.info())

# Carregar o dicionário JSON usando a codificação UTF-8 para evitar problemas com caracteres especiais
with open("DicionarioDados_Balanco_Energia_Subsistema.json", "r", encoding="utf-8") as arquivo:
    dicionario_colunas = json.load(arquivo)

#print("\nDicionário de colunas carregado!", dicionario_colunas)

lista_descricao = [
    item["descricao"]
    for item in dicionario_colunas["dicionario_simplificado"]
 ]

# alterar os nomes das colunas do DataFrame com base na lista de descrições do DicionarioDados_Balanco_Energia_Subsistema.json
df_final.columns = lista_descricao

# verifica se as colunas foram alteradas corretamente
#print(df_final.columns)

#verifica dados não numerico nas colunas que deveriam ser numericas
# df_final.info()

# df_final.shape

#convertendo a coluna "Data de Referência" para o tipo datetime 2023-01-01 00:00:00
df_final["Data de Referência"] = pd.to_datetime(df_final["Data de Referência"], format="%Y-%m-%d %H:%M:%S")

df_final["ano"] = df_final["Data de Referência"].dt.year
df_final["mes"] = df_final["Data de Referência"].dt.month
df_final["dia"] = df_final["Data de Referência"].dt.day
df_final["hora"] = df_final["Data de Referência"].dt.hour

print(df_final.info())

# retirar 99.999 dos valores das colunas

import pandas as pd

# Selecionar colunas numéricas
colunas_numericas = df_final.select_dtypes(include="number").columns

for coluna in colunas_numericas:

    # Converter a coluna para float64
    df_final[coluna] = df_final[coluna].astype("float64")

    # Converter temporariamente para string
    valores = df_final[coluna].astype(str)

    # Remover o .0 apenas dos números inteiros
    # valores = valores.str.replace(r"\.0$", "", regex=True)

    # Identificar valores terminados em 99999
    mascara = valores.str.endswith("99999", na=False)

    # Só executar se houver valores para corrigir
    if mascara.any():

        # Retirar os últimos 5 dígitos
        valores_corrigidos = pd.to_numeric(
            valores.loc[mascara].str[:-5],
            errors="coerce"
        )

        # Sobrescrever os valores
        df_final.loc[mascara, coluna] = valores_corrigidos.astype("float64")

        print(f"{coluna}: {mascara.sum()} valores corrigidos")

# 

#exportar dataframe final para um arquivo CSV
# caminho_saida = pasta / "BALANCO_ENERGIA_SUBSISTEMA_2023_2024_2025.csv"
# df_final.to_csv(caminho_saida, index=False, encoding='utf-8-sig', sep=";")
