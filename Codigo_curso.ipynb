# coincidentes e não coincidentes entre os subsistemas.

print(df.describe(include="all"))

idx_max = df_final.groupby("Nome do Subsistema")["Valor verificado da carga, em MWmed"].idxmax()
idx_min = df_final.groupby("Nome do Subsistema")["Valor verificado da carga, em MWmed"].idxmin()

maximos = df_final.loc[idx_max, ["Nome do Subsistema", "Data de Referência", "Valor verificado da carga, em MWmed"]]
minimos = df_final.loc[idx_min, ["Nome do Subsistema", "Data de Referência", "Valor verificado da carga, em MWmed"]]

print("\nMÁXIMOS")
print(maximos)

print("\nMÍNIMOS")
print(minimos)

idx_max = (
    df_final.groupby(["Nome do Subsistema", "ano"])
    ["Valor verificado da carga, em MWmed"]
    .idxmax()
)
idx_min = (
    df_final.groupby(["Nome do Subsistema", "ano"])
    ["Valor verificado da carga, em MWmed"]
    .idxmin()
)
# Máximos
maximos = df_final.loc[
    idx_max,
    [
        "Nome do Subsistema",
        "ano",
        "Data de Referência",
        "Valor verificado da carga, em MWmed"
    ]
]
# Mínimos
minimos = df_final.loc[
    idx_min,
    [
        "Nome do Subsistema",
        "ano",
        "Data de Referência",
        "Valor verificado da carga, em MWmed"
    ]
]
print(f"\nValores maximos para os subsistema por ano \n", idx_max)
print(f"\nValores minimos para os subsistema por ano \n", idx_min)
            # Índices dos valores máximos e mínimos por Subsistema e Ano
# Identificação
maximos["Tipo"] = "idx_max"

comparacao = maximos.copy()

# Garantir que a data esteja no formato datetime
comparacao["Data de Referência"] = pd.to_datetime(
    comparacao["Data de Referência"]
)

# Ordenar os subsistemas pelo maior valor de carga
ordem_subsistemas = (
    comparacao
    .groupby("Nome do Subsistema")[
        "Valor verificado da carga, em MWmed"
    ]
    .max()
    .sort_values(ascending=False)
    .index
    .tolist()
)

# Criar gráficos
g = sns.catplot(
    data=comparacao,
    x="ano",
    y="Valor verificado da carga, em MWmed",
    hue="Tipo",
    col="Nome do Subsistema",
    col_order=ordem_subsistemas,
    kind="bar",
    col_wrap=2,
    height=4,
    aspect=1.3,
    sharey=False
)

# Título de cada gráfico
g.set_titles("{col_name}")

# Título geral
g.fig.suptitle(
    "Valores Máximos de Carga do SIN e por Subsistemas (Não Coincidentes)",
    fontsize=16,
    fontweight="bold",
    y=1.03
)

# Percorrer cada subsistema
for ax, subsistema in zip(
    g.axes.flat,
    ordem_subsistemas
):

    # Eixos
    ax.set_xlabel("Ano")
    ax.set_ylabel("Carga (MWmed)")

    # Mostrar os anos em todos os gráficos
    ax.tick_params(
        axis="x",
        labelbottom=True
    )

    # Dados do subsistema
    dados_sub = (
        comparacao[
            comparacao["Nome do Subsistema"] == subsistema
        ]
        .sort_values("ano")
        .reset_index(drop=True)
    )

    # Barras do gráfico
    barras = ax.patches

    # Maior valor de carga do subsistema
    maior_valor = dados_sub[
        "Valor verificado da carga, em MWmed"
    ].max()

    # ------------------------------------------------
    # Posições fixas das informações
    # ------------------------------------------------

    # Data/hora
    y_data = maior_valor * 1.04

    # Valor de carga
    y_valor = maior_valor * 1.10

    # ------------------------------------------------
    # Adicionar valor + data/hora
    # ------------------------------------------------

    for barra, (_, linha) in zip(
        barras,
        dados_sub.iterrows()
    ):

        valor = linha[
            "Valor verificado da carga, em MWmed"
        ]

        data = linha[
            "Data de Referência"
        ]

        # -----------------------------
        # Formatar valor
        # -----------------------------

        valor_texto = (
            f"{valor:,.0f}"
            .replace(",", ".")
        )

        # -----------------------------
        # Formatar data + horário
        # -----------------------------

        data_hora_texto = data.strftime(
            "%d/%m/%Y %H:%M"
        )

        # Centro da barra
        x = (
            barra.get_x()
            + barra.get_width() / 2
        )

        # -----------------------------
        # Data e horário
        # -----------------------------

        ax.text(
            x,
            y_data,
            data_hora_texto,
            ha="center",
            va="bottom",
            fontsize=7
        )

        # -----------------------------
        # Valor máximo
        # -----------------------------

        ax.text(
            x,
            y_valor,
            valor_texto,
            ha="center",
            va="bottom",
            fontsize=9,
            fontweight="bold"
        )

    # ------------------------------------------------
    # Ajustar escala
    # ------------------------------------------------

    ax.set_ylim(
        0,
        maior_valor * 1.20
    )

    # Grid horizontal
    ax.grid(
        axis="y",
        alpha=0.3
    )
    
# Ajustar layout
plt.tight_layout()

# Mostrar
plt.show()
Observamos nos graficos do periodo de 2023,2024 e 2025 que:

SIN: Máximo coincidente entre todos os subsistemas, ocorreu em 26/02/2025, dia útil, as 14hs no pico do horario comercial onde ocorreu temperatura elevada principalmente no Sudeste/Centro-Oeste e SUL. Para todo o SIN, o horario de maior carga ocorreu as 14 hs influenciado pelo influencia dos subsistemas Sudeste/Centro-Oeste e Sul.

Sudeste/Centro-Oeste: subsistema de maior influencia na carga do SIN, máximo ocorreu em 18/02/2025, dia útil, as 14hs no pico do horario comercial onde ocorreu temperatura elevada. No ano de 2024 observamos uma redução em relação a 2023. Neste subsistema observamos que o maior valor critico ocorreu no periodo das 14hs em todos os anos.

Sul: apresentou crescimento contínuo dos máximos, atingindo o maior valor em 18/02/2025, dia útil, as 14hs no pico do horario comercial onde ocorreu temperatura elevada.
Neste subsistema, também observamos que o maior valor critico ocorreu no periodo das 14hs em todos os anos.

Nordeste: tem um comportamento mais variável, com máximo em 08/02/2024 e redução em 2025. Observa-se que os maximos ocorreram em horarios distintos.

Norte: apresenta crescimento consistente, com maximo valor ocorrendo em 17/11/2025, o que indica umao forte expansão da carga. Observa-se que a maior carga nos anos de 2023 e 2024 ocorreu no final do perído de inverno e em 2025 passou para novembro. Observa-se que os maximos ocorreram em horarios distintos, e que em 2023 e 2025 foram em horarios proximos.
