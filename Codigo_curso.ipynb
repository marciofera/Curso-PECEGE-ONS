]

# Garantir os tipos corretos
df_sem_ocorrencia[coluna_data] = pd.to_datetime(
    df_sem_ocorrencia[coluna_data],
    dayfirst=True,
    errors="coerce"
)

df_sem_ocorrencia[coluna_ano] = df_sem_ocorrencia[coluna_data].dt.year

df_sem_ocorrencia[coluna_carga] = pd.to_numeric(
    df_sem_ocorrencia[coluna_carga],
    errors="coerce"
)

for coluna in colunas_geracao:
    df_sem_ocorrencia[coluna] = pd.to_numeric(
        df_sem_ocorrencia[coluna],
        errors="coerce"
    )

# Remover linhas sem carga, data ou subsistema
df_analise = df_sem_ocorrencia.dropna(
    subset=[
        coluna_subsistema,
        coluna_data,
        coluna_carga,
        coluna_ano
    ]
).copy()

# Índices das cargas máximas e mínimas
idx_max = (
    df_analise
    .groupby([coluna_subsistema, coluna_ano])[coluna_carga]
    .idxmax()
)

idx_min = (
    df_analise
    .groupby([coluna_subsistema, coluna_ano])[coluna_carga]
    .idxmin()
)

# Registros completos dos instantes selecionados
dados_maximos = df_analise.loc[idx_max].copy()
dados_minimos = df_analise.loc[idx_min].copy()

dados_maximos["Tipo de carga"] = "Máxima"
dados_minimos["Tipo de carga"] = "Mínima"
def grafico_parcelas_geracao(dados, tipo_carga):

    if dados.empty:
        print(f"Não existem dados para carga {tipo_carga}.")
        return

    ordem_subsistemas = (
        dados
        .groupby(coluna_subsistema)[coluna_carga]
        .max()
        .sort_values(ascending=False)
        .index
        .tolist()
    )

    print("Subsistemas encontrados:", ordem_subsistemas)

    for subsistema in ordem_subsistemas:

        dados_sub = (
            dados[
                dados[coluna_subsistema] == subsistema
            ]
            .sort_values(coluna_ano)
            .copy()
        )

        print(
            f"Gerando gráfico: {subsistema} - "
            f"{len(dados_sub)} registros"
        )

        # Verificar se existem colunas de geração
        dados_grafico = (
            dados_sub
            .set_index(coluna_ano)[colunas_geracao]
            .apply(pd.to_numeric, errors="coerce")
            .fillna(0)
        )

        # Criar figura explicitamente
        fig, ax = plt.subplots(
            figsize=(12, 6)
        )

        dados_grafico.plot(
            kind="bar",
            stacked=True,
            width=0.75,
            ax=ax
        )

        ax.set_title(
            f"Parcelas de Geração - Carga {tipo_carga}\n"
            f"{subsistema}",
            fontsize=14,
            fontweight="bold"
        )

        ax.set_xlabel("Ano")
        ax.set_ylabel("Geração (MWmed)")

        ax.tick_params(
            axis="x",
            rotation=0
        )

        ax.grid(
            axis="y",
            alpha=0.3
        )

        # --------------------------
        # Valores dentro das barras
        # --------------------------

        for container in ax.containers:

            labels = []

            for barra in container:

                valor = barra.get_height()

                if pd.notna(valor) and valor > 0:

                    labels.append(
                        f"{valor:,.0f}".replace(",", ".")
                    )

                else:
                    labels.append("")

            ax.bar_label(
                container,
                labels=labels,
                label_type="center",
                fontsize=8
            )

        # --------------------------
        # Soma das parcelas
        # --------------------------

        totais = dados_grafico.sum(axis=1)

        # --------------------------
        # Carga e data
        # --------------------------

        for posicao, (_, linha) in enumerate(
            dados_sub.iterrows()
        ):

            carga = linha[coluna_carga]

            carga_texto = (
                f"{carga:,.0f}"
                .replace(",", ".")
            )

            data_texto = linha[coluna_data].strftime(
                "%d/%m/%Y %H:%M"
            )

            ax.text(
                posicao,
                totais.iloc[posicao] * 1.1,
                f"Carga: {carga_texto} MWmed\n"
                f"{data_texto}",
                ha="center",
                va="bottom",
                fontsize=8,
                fontweight="bold"
            )

        # --------------------------
        # Ajustar escala
        # --------------------------

        maior_total = totais.max()

        if maior_total > 0:

            ax.set_ylim(
                0,
                maior_total * 1.25
            )

        # --------------------------
        # Legenda
        # --------------------------

        ax.legend(
            title="Fonte de geração",
            bbox_to_anchor=(1.02, 1),
            loc="upper left"
        )

        plt.tight_layout()

        # Mostrar explicitamente a figura
        plt.show()
def grafico_parcelas_geracao(dados, tipo_carga):

    if dados.empty:
        print(f"Não existem dados para carga {tipo_carga}.")
        return

    # Ordenar subsistemas pela carga
    ordem_subsistemas = (
        dados
        .groupby(coluna_subsistema)[coluna_carga]
        .max()
        .sort_values(ascending=False)
        .index
        .tolist()
    )

    for subsistema in ordem_subsistemas:

        # -------------------------------------------------
        # DADOS DO SUBSISTEMA
        # -------------------------------------------------

        dados_sub = (
            dados[
                dados[coluna_subsistema] == subsistema
            ]
            .sort_values(coluna_ano)
            .copy()
        )

        # Parcelas de geração
        dados_grafico = (
            dados_sub
            .set_index(coluna_ano)[colunas_geracao]
            .apply(pd.to_numeric, errors="coerce")
            .fillna(0)
        )

        # -------------------------------------------------
        # CRIAR GRÁFICO
        # -------------------------------------------------

        fig, ax = plt.subplots(
            figsize=(12, 6)
        )

        dados_grafico.plot(
            kind="bar",
            stacked=True,
            width=0.75,
            ax=ax
        )

        # -------------------------------------------------
        # TÍTULO
        # -------------------------------------------------

        ax.set_title(
            f"Parcelas de Geração nos Instantes de Carga {tipo_carga}\n"
            f"{subsistema}",
            fontsize=14,
            fontweight="bold"
        )

        ax.set_xlabel("Ano")
        ax.set_ylabel("Geração (MWmed)")

        ax.tick_params(
            axis="x",
            rotation=0
        )

        ax.grid(
            axis="y",
            alpha=0.3
        )

        # -------------------------------------------------
        # VALORES DE CADA PARCELA
        # -------------------------------------------------

        for container in ax.containers:

            labels = []

            for barra in container:

                valor = barra.get_height()

                if pd.notna(valor) and valor > 0:

                    labels.append(
                        f"{valor:,.0f}".replace(",", ".")
                    )

                else:
                    labels.append("")

            ax.bar_label(
                container,
                labels=labels,
                label_type="center",
                fontsize=8
            )

        # -------------------------------------------------
        # TOTAL DE GERAÇÃO DE CADA ANO
        # -------------------------------------------------

        totais = dados_grafico.sum(axis=1)

        # Maior barra de geração entre TODOS os anos
        maior_total_geracao = totais.max()

        # -------------------------------------------------
        # POSIÇÃO FIXA DOS TEXTOS
        # -------------------------------------------------

        # Todos os textos ficarão alinhados acima
        # da maior barra de geração
        
        # criar um ajuste de valores para os subisitemas com valores muito baixos, para que o texto não fique sobre a barra
        
        if subsistema == "SISTEMA INTERLIGADO NACIONAL": 
            ajuste = 1
        elif subsistema == "SUDESTE/CENTRO-OESTE":
            ajuste = 1.2
        elif subsistema == "SUL":
            ajuste = 1.2
        elif subsistema == "NORDESTE":
            ajuste = 1.1
        elif subsistema == "NORTE":
            ajuste = 1.1
        
        
        y_texto = maior_total_geracao * 1.04 * ajuste
        print(f"Subsistema: {subsistema}, ajuste: {ajuste}, y_texto: {y_texto}")

        # -------------------------------------------------
        # CARGA MÁXIMA + DATA + HORÁRIO
        # -------------------------------------------------

        for posicao, (_, linha) in enumerate(
            dados_sub.iterrows()
        ):

            carga = linha[coluna_carga]
            data = linha[coluna_data]

            # Formatar carga
            carga_texto = (
                f"{carga:,.0f}"
                .replace(",", ".")
            )

            # Data
            data_texto = data.strftime(
                "%d/%m/%Y"
            )

            # Horário
            hora_texto = data.strftime(
                "%H:%M"
            )

            # Texto completo
            texto = (
                f"Carga: {carga_texto} MWmed\n"
                f"{data_texto} "
                f"{hora_texto}"
            )

            # Texto alinhado pela maior barra
            ax.text(
                posicao,
                y_texto,
                texto,
                ha="center",
                va="bottom",
                fontsize=8,
                fontweight="bold"
            )

        # -------------------------------------------------
        # AJUSTAR ESCALA
        # -------------------------------------------------

        # Criar espaço acima para carga + data + horário
        ax.set_ylim(
            0,
            maior_total_geracao * 1.5
        )

        # -------------------------------------------------
        # LEGENDA
        # -------------------------------------------------

        ax.legend(
            title="Fonte de geração",
            bbox_to_anchor=(1.02, 1),
            loc="upper left"
        )

        plt.tight_layout()
        plt.show()
